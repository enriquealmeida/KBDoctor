    </Reference>
    <Reference Include="Artech.MsBuild.Common">
      <HintPath>$(GX_SDK_DIR)\bin\Artech.MsBuild.Common.dll</HintPath>
    </Reference>
    <Reference Include="Artech.Packages.Patterns">
