<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Concepto.Packages.KBDoctor</RootNamespace>
    <AssemblyName>KBDoctor</AssemblyName>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <PublishUrl>publish\</PublishUrl>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <UseApplicationTrust>false</UseApplicationTrust>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <StartAction>Program</StartAction>
    <StartProgram>$(GX_PROGRAM_DIR)\GeneXus.exe</StartProgram>
    <DefineConstants>$(TargetGenexusVersion)</DefineConstants>
    <ErrorReport>none</ErrorReport>
    <WarningLevel>2</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineConstants>$(TargetGeneXusVersion)</DefineConstants>
    <WarningLevel>2</WarningLevel>
    <RunCodeAnalysis>false</RunCodeAnalysis>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants Condition="'$(TargetFrameworkVersion)' == 'v3.5' ">EVO3</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>Resources\Icons\Red-Cross.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <SystemResourcesExtensionsPath Condition="Exists('$(GX_PROGRAM_DIR)\System.Resources.Extensions.dll')">$(GX_PROGRAM_DIR)\System.Resources.Extensions.dll</SystemResourcesExtensionsPath>
    <SystemResourcesExtensionsPath Condition="'$(SystemResourcesExtensionsPath)' == '' and Exists('$(GX_PROGRAM_DIR)\..\GeneXus18\System.Resources.Extensions.dll')">$(GX_PROGRAM_DIR)\..\GeneXus18\System.Resources.Extensions.dll</SystemResourcesExtensionsPath>
    <SystemResourcesExtensionsPath Condition="'$(SystemResourcesExtensionsPath)' == '' and Exists('C:\GeneXus\GeneXus18\System.Resources.Extensions.dll')">C:\GeneXus\GeneXus18\System.Resources.Extensions.dll</SystemResourcesExtensionsPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>GX16</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WarningLevel>2</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>GX16</DefineConstants>
    <WarningLevel>2</WarningLevel>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Artech.Architecture.BL.Framework">
      <HintPath>$(GX_SDK_DIR)\bin\Artech.Architecture.BL.Framework.dll</HintPath>
    </Reference>
    <Reference Include="Artech.Architecture.Common">
      <HintPath>$(GX_SDK_DIR)\bin\Artech.Architecture.Common.dll</HintPath>
    </Reference>
    <Reference Include="Artech.Architecture.Interfaces">
      <HintPath>$(GX_SDK_DIR)\Bin\Artech.Architecture.Interfaces.dll</HintPath>
    </Reference>
    <Reference Include="Artech.Architecture.Language">
