    <Reference Include="Infragistics2.Shared.v11.1">
      <HintPath>$(GX_PROGRAM_DIR)\Infragistics2.Shared.v11.1.dll</HintPath>
    </Reference>
    <Reference Include="Infragistics2.Win.UltraWinGrid.v11.1">
      <HintPath>$(GX_PROGRAM_DIR)\Infragistics2.Win.UltraWinGrid.v11.1.dll</HintPath>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(GX_SDK_DIR)\bin\log4net.dll</HintPath>
    </Reference>
    <Reference Include="System.Resources.Extensions">
      <HintPath>$(SystemResourcesExtensionsPath)</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Condition=" '$(TargetFrameworkVersion)' == 'v3.5' " Include="Microsoft.Build.Tasks.v3.5" />
    <Reference Condition=" '$(TargetFrameworkVersion)' == 'v3.5' " Include="Microsoft.Build.Utilities.v3.5" />
    <Reference Condition=" '$(TargetFrameworkVersion)' == 'v4.6' " Include="Microsoft.Build.Tasks.v4.0" />
    <Reference Condition=" '$(TargetFrameworkVersion)' == 'v4.6' " Include="Microsoft.Build.Utilities.v4.0" />
    <Reference Condition=" '$(TargetFrameworkVersion)' == 'v4.7.1' " Include="Microsoft.Build.Tasks.v4.0" />
    <Reference Condition=" '$(TargetFrameworkVersion)' == 'v4.7.1' " Include="Microsoft.Build.Utilities.v4.0" />
    <Reference Include="Microsoft.Practices.EnterpriseLibrary.Common">
      <HintPath>$(GX_SDK_DIR)\bin\Microsoft.Practices.EnterpriseLibrary.Common.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Practices.EnterpriseLibrary.ExceptionHandling">
      <HintPath>$(GX_SDK_DIR)\bin\Microsoft.Practices.EnterpriseLibrary.ExceptionHandling.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Practices.ObjectBuilder">
      <HintPath>$(GX_SDK_DIR)\bin\Microsoft.Practices.ObjectBuilder.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="$(GX_SDK_DIR)\Src\CommonPackageInfo.cs">
      <Link>CommonPackageInfo.cs</Link>
    </Compile>
    <Compile Update="Sources\KBDoctorToolWindow.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Catalog.xml">
      <SubType>Designer</SubType>
    </Content>
    <Content Include="Documentacion\Cambios.txt" />
    <Content Include="Documentacion\HowTo.txt" />
    <Content Include="Documentacion\LoQueFaltaHacer.txt" />
    <Content Include="Resources\Icons\file-find.ico" />
    <Content Include="Resources\Icons\favicon.ico" />
    <None Update="Resources\specXEv2.xsl">
      <SubType>Designer</SubType>
    </None>
    <EmbeddedResource Include="KBDoctor.package">
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <BootstrapperPackage Include="Microsoft.Net.Client.3.5">
      <Visible>False</Visible>
      <ProductName>.NET Framework 3.5 SP1 Client Profile</ProductName>
      <Install>false</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.Net.Framework.3.5.SP1">
      <Visible>False</Visible>
      <ProductName>.NET Framework 3.5 SP1</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.Windows.Installer.3.1">
      <Visible>False</Visible>
      <ProductName>Windows Installer 3.1</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KBDoctorCore\KBDoctorCore.csproj" />
    <ProjectReference Include="..\Louvain\LouvainCommunityPL.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Properties\Resources.Designer.cs" />
    <Compile Remove="SearchReplace.cs" />
    <Compile Remove="SearchReplace.Designer.cs" />
    <Compile Remove="Sources\Modularization.cs" />
    <Compile Remove="Sources\Modularization.Designer.cs" />
    <EmbeddedResource Remove="SearchReplace.resx" />
    <EmbeddedResource Remove="Sources\Modularization.resx" />
  </ItemGroup>
  <Target Name="AfterBuild">
    <Message Text="Version = $(Major).$(Minor).$(Build).$(Revision)" Importance="high" />
  </Target>
  <Target Name="CopyKBDoctorToGeneXusPackages" AfterTargets="Build" Condition="'$(GX_PROGRAM_DIR)' != ''">
    <ItemGroup>
      <KBDoctorDebugFiles Include="$(TargetDir)KBDoctor*.dll;$(TargetDir)KBDoctor*.pdb;$(TargetDir)KBDoctor*.dll.config" />
      <KBDoctorDependencyFiles Include="$(SystemResourcesExtensionsPath)" Condition="'$(SystemResourcesExtensionsPath)' != ''" />
      <KBDoctorDependencyFiles Include="$(GX_PROGRAM_DIR)\System.Memory.dll" />
      <KBDoctorDependencyFiles Include="$(GX_PROGRAM_DIR)\System.Buffers.dll" />
      <KBDoctorDependencyFiles Include="$(GX_PROGRAM_DIR)\System.Numerics.Vectors.dll" />
      <KBDoctorDependencyFiles Include="$(GX_PROGRAM_DIR)\System.Runtime.CompilerServices.Unsafe.dll" />
    </ItemGroup>
    <MakeDir Directories="$(GX_PROGRAM_DIR)\Packages" />
    <Copy SourceFiles="@(KBDoctorDebugFiles)" DestinationFolder="$(GX_PROGRAM_DIR)\Packages\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(KBDoctorDependencyFiles)" DestinationFolder="$(GX_PROGRAM_DIR)\Packages\" SkipUnchangedFiles="true" />
    <Message Text="Copied @(KBDoctorDebugFiles->'%(Filename)%(Extension)', ', '), @(KBDoctorDependencyFiles->'%(Filename)%(Extension)', ', ') to $(GX_PROGRAM_DIR)\Packages" Importance="high" />
  </Target>
  <Target Name="WarnMissingGeneXusInstallDir" AfterTargets="Build" Condition="'$(GX_PROGRAM_DIR)' == ''">
    <Warning Text="GX_PROGRAM_DIR is not set. KBDoctor assemblies were not copied to the GeneXus Packages directory." />
  </Target>
  <PropertyGroup>
    <RunAnalyzersDuringBuild>False</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
